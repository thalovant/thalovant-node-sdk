{
  "name": "@thalovant/sdk",
  "version": "0.2.13",
  "description": "Node.js and TypeScript SDK for direct Thalovant hub data-plane clients and agents",
  "type": "module",
  "license": "MIT",
  "author": "Thalovant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thalovant/thalovant-node-sdk.git"
  },
  "homepage": "https://docs.thalovant.com/developers/sdks/node/",
  "bugs": {
    "url": "https://github.com/thalovant/thalovant-node-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "thalovant",
    "sdk",
    "agent",
    "voice",
    "assistant",
    "iot"
  ],
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mqtt": "^5.15.1",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  }
}
